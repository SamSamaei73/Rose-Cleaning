# Explicitly choose connected (default) or demo. Demo never uses Supabase or sends email.
APP_MODE=connected
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ character secret: openssl rand -hex 32 (required in connected mode)
APP_SECRET=
# preview (default) or resend. Resend also requires explicit EMAIL_SEND_ENABLED=true.
EMAIL_PROVIDER=preview
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Optional owner-approved public contact details; leave blank until supplied.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_OPENING_HOURS=
# Protected dispatch endpoint for a scheduler, optional. Generate a separate secret.
CRON_SECRET=
# Optional local database test target; scripts/test-db.sh can start an isolated local cluster.
TEST_DATABASE_URL=
