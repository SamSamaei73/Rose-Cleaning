# Explicitly choose connected (default) or demo. Demo never uses Supabase or sends email.
APP_MODE=connected
# Supabase Auth Site URL must match this origin; allow /auth/callback redirects.
# See docs/CUSTOMER-SETUP.md for verification and recovery templates.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random 32+ character secret: openssl rand -hex 32 (required in connected mode)
APP_SECRET=
# preview (default) or resend. Resend also requires explicit EMAIL_SEND_ENABLED=true.
EMAIL_PROVIDER=preview
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Contact forwarding only. Supabase sends verification/recovery to each customer.
CONTACT_TO_EMAIL=rose.cleaning.uk@icloud.com
# Optional override; the supplied info@rosecleaning.uk address is the default.
NEXT_PUBLIC_CONTACT_EMAIL=
# Address and opening hours remain unpublished until supplied.
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_OPENING_HOURS=
# Protected dispatch endpoint for a scheduler, optional. Generate a separate secret.
CRON_SECRET=
# Optional test target: a running PostgreSQL server where the script may create/drop its own test database.
TEST_DATABASE_URL=
# Non-secret deployment identity, supplied by GitHub Actions during the build.
ROSE_RELEASE_SHA=
ROSE_RELEASE_ID=
