{
  "name": "rose-professional-cleaning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:demo": "APP_MODE=demo next dev --webpack",
    "build": "next build --webpack",
    "build:cpanel": "node scripts/build-cpanel.mjs",
    "start": "next start",
    "start:demo": "APP_MODE=demo next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/deployment.test.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "bash scripts/test-db.sh",
    "test:connected": "node --env-file=.env.local scripts/test-connected.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "lucide-react": "1.75.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "vite": "7.3.8"
  },
  "overrides": {
    "rollup": "4.63.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
